# Video Chat サーバの設定 (./scripts/setup.sh 初回実行時に .env へコピーされます)
# 値はシングルクォートで囲んでください。変更はサーバの再起動 (./scripts/stop.sh && ./scripts/start.sh) で反映されます。

# ===== ローカルサーバ =====
# 待受アドレス。gate-house の ORIGIN_URL には 'http://<このアドレス>' を設定します。
# トンネル経由でのみ公開するため、127.0.0.1 (このマシン内のみ) のままにしてください。
LISTEN_ADDR='127.0.0.1:8080'

# ===== ICE サーバ (P2P 接続に使用。シグナリング時にクライアントへ配布) =====
# STUN: カンマ区切りで複数指定可
STUN_URLS='stun:stun.l.google.com:19302'
# TURN: 任意。双方が厳しい NAT/ファイアウォールの内側にいると STUN だけでは繋がらないため、その場合に設定
#   認証情報はシグナリング時に利用者のブラウザへ配布されます。このアプリ専用の権限を絞ったものを使ってください
#   例: TURN_URLS='turn:turn.example.com:3478?transport=udp, turns:turn.example.com:5349'
TURN_URLS=''
TURN_USERNAME=''
TURN_CREDENTIAL=''

# ===== ビルド =====
# go コマンドが PATH に無い場合のみ指定 (例: GO='/usr/local/go/bin/go')
GO=''
